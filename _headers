/*
  # ============================================================
  # Usul Learning — Cloudflare Pages / Pages _headers file
  # Deploy this file in the ROOT of your site.
  # Cloudflare Pages reads it automatically.
  # If hosting elsewhere, configure these in your server/proxy.
  # ============================================================

  # ── Strict Transport Security (HSTS) ──────────────────────
  # Forces HTTPS for 1 year. includeSubDomains covers all
  # subdomains. preload submits to browser preload lists.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # ── Clickjacking protection ────────────────────────────────
  X-Frame-Options: DENY

  # ── MIME-type sniffing protection ─────────────────────────
  X-Content-Type-Options: nosniff

  # ── Referrer policy ───────────────────────────────────────
  # Sends referrer only within same origin; nothing to external
  # sites. Protects user privacy when clicking outbound links.
  Referrer-Policy: strict-origin-when-cross-origin

  # ── Permissions Policy ────────────────────────────────────
  # Disables browser features the site doesn't use.
  # Prevents malicious scripts from accessing camera, mic, etc.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # ── Content Security Policy ───────────────────────────────
  # Allowlist of every source the site legitimately loads from.
  # Anything not listed is blocked by the browser.
  #
  # default-src 'self'          — block everything by default
  # script-src  'self'          — only our own main.js
  #             + static.cloudflareinsights.com — Cloudflare Web Analytics beacon
  #               (injected automatically by Cloudflare at the edge)
  # style-src   'self' fonts.googleapis.com — styles.css + Google Fonts CSS
  # font-src    fonts.gstatic.com           — the actual font files
  # img-src     'self' data:               — local images + inline data: SVGs
  # connect-src 'self' api.web3forms.com   — contact form direct to Web3Forms
  #             + cloudflareinsights.com    — beacon reporting endpoint
  # frame-ancestors 'none'      — belt-and-suspenders vs clickjacking
  # base-uri    'self'          — prevent base tag injection
  # form-action 'self'          — prevent form hijacking
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-MDoFK+0/2M87+yVzsbrnrvmUbHnk3/B9AvS3dlp+cZw=' 'sha256-nlR2/8drInnHVeayFQts7F0TJn5KjVyXAvOPG/c+zJI='; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com

  # ── Cross-Origin policies ─────────────────────────────────
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/main.js
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate

/llms.txt
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/plain; charset=utf-8

/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

/favicon-*.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/android-chrome-*.png
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800, must-revalidate

/assets/*.jpg
  Content-Type: image/jpeg

/assets/*.jpeg
  Content-Type: image/jpeg
